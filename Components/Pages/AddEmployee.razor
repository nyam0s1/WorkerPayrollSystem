@page "/add"
@page "/edit/{Id:guid}"
@rendermode InteractiveServer
@using Blazor_Training.Domain
@inject Blazor_Training.Application.EmployeeService Service
@inject NavigationManager NavManager
@using System.ComponentModel.DataAnnotations

<nav class="navbar">
	<div class="logo">PayRoll System</div>
	<div class="nav-links">
		<NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
		<NavLink href="About">About</NavLink>
	</div>
</nav>
<div class="main-layout">
	<button class="sidebarToggle" @onclick="() => sidebarVisible = !sidebarVisible">☰</button>
	<nav class="@(sidebarVisible ? "sidebar" : "sidebar collapse")">
		<NavLink class="btn btn-blue" href="add">➕Add Employee</NavLink>
		<NavLink class="btn btn-blue" href="employees">📃View Employees</NavLink>
		<NavLink class="btn btn-blue" href="overtime">Overtime Section</NavLink>
		<NavLink class="btn btn-blue" href="calculator">🖩Tax Calculator</NavLink>
		<NavLink class="btn btn-blue" href="settings">⚙️Settings</NavLink>
	</nav>

	<div class="InputForm">
		<h1>@(isEditMode ? "Edit Employee" : "New Employee")</h1>
		@if (employeeNotFound)
		{
			<p>Employee not found. They may have been removed.</p>
			<NavLink class="btn btn-blue" href="employees">Back to Employees</NavLink>
		}
		else
		{
			<EditForm Model="newEmployee" OnValidSubmit="SaveEmployee">
				<DataAnnotationsValidator />
				<ValidationSummary />
				@if (formError != null)
				{
					<p class="text-danger" role="alert">@formError</p>
				}
				<div>
					<label for="employee-name">Name</label><br />
					<InputText id="employee-name" placeholder="Enter Employee name" @bind-Value="newEmployee.Name" class="form-control" />
				</div>
				<div>
					<label for="employee-rate">Rate of Pay per Hour</label><br />
					<InputNumber id="employee-rate" placeholder="Enter Employee payrate" @bind-Value="newEmployee.hourlyPay" class="form-control" />
				</div>
				<div>
					<label for="employee-hours">Number of Hours Worked</label><br />
					<InputNumber id="employee-hours" placeholder="Enter Worked Hours" @bind-Value="newEmployee.hoursWorked" class="form-control" />
				</div>
				<button type="submit" class="btn btn-blue">Submit</button>
				<button type="button" class="btn btn-red" @onclick="Cancel">Cancel</button>
			</EditForm>
		}
	</div>
</div>

@code
{
	bool sidebarVisible = true;
	[Parameter]
	public Guid Id { get; set; }
	Employee newEmployee = new Employee();
	bool employeeNotFound;
	bool isEditMode;
	string? formError;
	protected override void OnParametersSet()
	{
		formError = null;
		employeeNotFound = false;
		isEditMode = NavManager.ToBaseRelativePath(NavManager.Uri).StartsWith("edit/", StringComparison.OrdinalIgnoreCase);
		if (!isEditMode)
			Id = Guid.Empty;

		if (isEditMode)
		{
			var foundEmployee = Service.GetEmployee(Id);
			employeeNotFound = foundEmployee == null;
			newEmployee = foundEmployee ?? new Employee();
		}
		else
			newEmployee = new Employee();
	}
	void SaveEmployee()
	{
		if (employeeNotFound)
			return;
		if (!newEmployee.hourlyPay.HasValue || !newEmployee.hoursWorked.HasValue)
		{
			formError = "Enter both the hourly rate and hours worked.";
			return;
		}

		if (!isEditMode)
		{
			Service.AddEmployee(newEmployee);
		}
		else
		{
			if (!Service.UpdateEmployee(newEmployee))
			{
				employeeNotFound = true;
				return;
			}
		}
		NavManager.NavigateTo("/employees");
	}

	void Cancel()
	{
		NavManager.NavigateTo("/employees");
	}
}
